# Copy to .env for local docker-compose testing.
# Must satisfy OpenSearch's strong-password requirement (letters, digits, special char, 8+ chars).
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Ch4ngeMe!123

INDEX_NAME=rag-documents

# Local RustFS (S3-compatible) credentials for saving/loading uploaded files.
S3_BUCKET=rag-documents
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

# For real AWS S3 in production, set S3_BUCKET plus standard AWS credentials
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION) and leave
# S3_ENDPOINT_URL unset so boto3 talks to AWS instead of local RustFS.
